# htaccess for Online Quiz System (QuizPoint)
# Apache configuration for security headers, URL handling, and error pages.

# Disable directory listing
Options -Indexes

# Follow symbolic links
Options +FollowSymLinks

# Enable rewrite engine
RewriteEngine On

# HTTPS redirect (uncomment on production with SSL)
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# www to non-www redirect (uncomment and adjust for your domain)
# RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
# RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# Custom error pages
ErrorDocument 403 /online-quiz-system/403.php
ErrorDocument 404 /online-quiz-system/404.php
ErrorDocument 500 /online-quiz-system/500.php

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set X-XSS-Protection "1; mode=block"
    Header set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'self'"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Prevent access to sensitive files
<FilesMatch "\.(sql|md|example\.php|log|ini)$">
    Require all denied
</FilesMatch>

# Prevent access to includes directory via URL
<IfModule mod_rewrite.c>
    RewriteRule ^includes/ - [F,L]
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

# Compress text-based content
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
